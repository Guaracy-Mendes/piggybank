@startuml
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()
title C4 L3 - Implemented payment components and financial evidence ports
Container_Ext(customer,"Customer web","React / TypeScript","Receiving, recipient, review, reauthentication and tracking")
Container_Ext(staff,"Staff web","React / TypeScript","Authorized payment inquiry and independent rail controls")
Container_Boundary(api,"bank-api and co-located domain crates") {
 Component(http,"Payments HTTP boundary","Axum","Trust / CSRF; typed immutable inputs; generated contract")
 Component(intent,"Payment intents","bank-payments","Stable economic identity; accepted intent before scheduling; owned status")
 Component(quotes,"Recipient and quote services","bank-payments","Explicit receiving reference; revocation/version guard; exact immutable price")
 Component(gates,"Execution policy","bank-payments","Current ownership, recipient, quote, proof and signed decision ports")
 Component(ingress,"Rail evidence ingress","bank-payments","Live authentication; exact scope; durable deduplication; owned quarantine")
 Component(credits,"Credit and return orchestration","bank-payments","Core-derived ownership; current checks; suspense / allocation receipt recovery")
 Component(commands,"Durable recovery commands","bank-payments","Current owner / operator; immutable reason and identity; bounded original inquiry / cancellation")
 Component(recon,"Financial reconciliation","bank-payments","Paged Core positions; workflow / scope / age / held total comparison; owned breaks")
 Component(core,"Core payment port","bank-core","Guarded booking / finality / suspense / allocation; atomic return cap; immutable receipts")
 Component(controls,"Current authority and checks","bank-controls","Explicit canonical person; current scope / queue; signed outcomes")
 Component(identity,"Issuer/BFF proof port","bank-identity","Details-bound reauthentication; opaque sessions; consumed proof identity")
}
Container_Boundary(worker,"bank-worker") {
 Component(job,"Registered payment handler","Leased / fenced jobs","Polls or resumes original operation; never recreates the payment")
 Component(creditJob,"Registered credit handler","Leased / fenced jobs","Original movement; durable acceptance before scheduling")
 Component(recovery,"Payment recovery and audit relay","Periodic bounded work","Durable scheduling / receipt recovery / owned cases / stable audit ID")
}
Container_Ext(rail,"Synthetic rail provider","bank-rails / bounded HTTP","Signed, durable deduplicated instructions and inquiry")
ContainerDb_Ext(pg,"PostgreSQL","Module roles","Payments owns intent; Core owns journal and balances; Controls owns audit")
Rel(customer,http,"Generated client + opaque cookie / CSRF")
Rel(staff,http,"Current workforce inquiry role + payments queue")
Rel(http,intent,"Create, confirm, read original payment")
Rel(http,quotes,"Register / revoke / quote")
Rel(intent,identity,"Fresh action proof")
Rel(intent,controls,"Approval and current permissions")
Rel(job,intent,"Original payment ID")
Rel(intent,gates,"Current execution policy")
Rel(gates,quotes,"Bound immutable quote and locked recipient")
Rel(gates,identity,"Current consumed proof")
Rel(gates,controls,"Current grants and signed sanctions / risk / fraud")
Rel(intent,core,"Same instruction and receipt lookup")
Rel(core,gates,"Validate trusted bound permit before new effects")
Rel(intent,rail,"Stable work + fence committed before HTTP; authenticated evidence")
Rel(rail,ingress,"Signed callbacks with distinct evidence and financial identities")
Rel(ingress,intent,"Original-bound finality; no acknowledgment downgrade")
Rel(ingress,credits,"Immutable typed incoming / linked return receipt")
Rel(creditJob,credits,"Resume original movement")
Rel(credits,core,"Record suspense / allocate with trusted bound permit")
Rel(credits,controls,"Current signed payment checks; owned exceptions")
Rel(ingress,controls,"Owned conflicting-evidence cases and audit")
Rel(http,commands,"Scoped idempotent requests and recovery history")
Rel(commands,intent,"Cancellation serializes with submission; original identity")
Rel(job,commands,"Registered recovery handler; bounded attempts")
Rel(commands,rail,"Original signed inquiry / cancellation; fenced transport")
Rel(recovery,recon,"Persistent cursor sweep; bounded pages")
Rel(recon,core,"Read financial positions; no money commands")
Rel(recon,controls,"Owned cases; retained observation and audit history")
Rel(core,pg,"Core role; guarded financial routine")
Rel(intent,pg,"Payments transaction / outbox / audit intent")
Rel(credits,pg,"Sealed credit identity; workflow and versioned facts")
Rel(recovery,intent,"Recover saved intent and original workflow")
Rel(recovery,controls,"Idempotent persisted audit record")
SHOW_LEGEND()
@enduml
