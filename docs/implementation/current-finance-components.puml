@startuml
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()
title C4 L3 - Finance exports, reports, reconciliation, liquidity, revisions, preview policies, native bases and controlled funding corrections (WP-24 in progress)
Container_Ext(staff,"Finance workforce view","React / TypeScript","Exact totals, sealed mapping, safe receipts and audited recovery")
Container_Boundary(runtime,"bank-api / bank-worker") {
 Component(audit_relay,"Durable audit relay","bank-finance / native SQL","Per-identity wrapping cursor; bounded attempts; immutable native Controls receipts; no financial commands")
 Component(http,"Finance HTTP boundary","Axum","Workforce BFF / CSRF; current Finance role and queue")
 Component(corrections,"Controlled funding corrections","bank-finance","Exact source / legs / reason; durable intent; independent approval; native receipt inquiry")
 Component(correction_core,"CorrectionCommands","bank-core","SYNTHETIC_FUNDING only; original + ordered account locks; live authority; available funds / restrictions; one linked reversal")
 Component(bases,"Native periodic basis observations","bank-core / bank-finance","Single-view native business-date prefix; exact source readback; immutable replay; saved-clock preview only")
 Component(policies,"Durable periodic policy proposals","bank-finance","PREVIEW_ONLY; exact policy/calendar; stable registration; independent canonical approval")
 Component(registry,"Periodic PolicyRegistry","bank-core","Narrow immutable configuration command; no ledger commands; exact preview engine")
 Component(chart,"Versioned chart publication","bank-finance","Independent details-bound approval; immutable effective mapping")
 Component(export,"Sealed GL exports","bank-finance","Unique Core source; immutable request / chart / lineage")
 Component(recovery,"Recovery commands","bank-finance","Exact reason / key / generation; bounded allowance; old jobs superseded")
 Component(discovery,"Bounded discovery and recovery","bank-finance","Persistent wrapping cursors; durable scheduling before transport")
 Component(job,"Registered Finance handler","bank-worker","Leased Platform job; transport fence; original batch inquiry")
 Component(core,"FinanceRecords read port","bank-core","Immutable journals, positions and native payment and credit accounting; no commands")
 Component(reports,"Immutable period observations","bank-finance","Consistent Core membership; GL controls; source digests; captured proofs")
 Component(match,"Outgoing reconciliation","bank-finance","Frozen instruction / file / accounting / journal / GL; exact fee and timing classes")
 Component(credit_match,"Incoming and return reconciliation","bank-finance","Signed credit file; suspense / allocation / original settlement / lifetime cap / GL")
 Component(group_match,"Closed multi-file reconciliation","bank-finance","Signed closed membership; all member proofs; cross-file differences and exact row lineage")
 Component(payment_read,"Payments FinanceReader","bank-payments","Bounded consistent quote / transport / archived finality and credit receipt reads; no commands")
 Component(cash,"Independent liquidity observations","bank-finance","Separate key / nonce / scope; missing or stale cash unavailable")
 Component(revisions,"Controlled report revisions","bank-finance","Durable exact-scope request; independent approval; linear immutable publication")
 Component(controls,"Authority, cases and audit","bank-controls","Current canonical roles / queues; owned Finance exceptions")
}
Container_Ext(provider,"Persistent synthetic GL","provider-simulator","Signed original-source deduplication; durable receipt / inquiry")
Container_Ext(clearing,"Independent clearing files","provider-simulator","Immutable signed scoped files; authentic negative row fixtures")
Container_Ext(liquidity,"Synthetic cash evidence","provider-simulator","Immutable versions; separate signing key; original as-of / expiry")
ContainerDb_Ext(db,"PostgreSQL","Separate module principals","Core financial authority; Finance export state; Simulator GL ledger")
Rel(http,audit_relay,"Read safe queue / original event / verified native receipt")
Rel(audit_relay,controls,"Append original identity / payload; independently confirm native stream evidence")
Rel(audit_relay,db,"Immutable source / attempts / receipts; guarded acknowledgment; persisted cursor")
Rel(discovery,audit_relay,"Bounded automatic progress; failed records retained")
Rel(staff,http,"Generated client + workforce session / CSRF")
Rel(http,corrections,"Propose / inspect / approve / explicitly execute original scope")
Rel(corrections,controls,"FINANCE_CORRECTION; canonical maker/checker; current roles and queues")
Rel(corrections,correction_core,"Exact-source financial command; same original execution UUID on replay")
Rel(correction_core,db,"Atomic balanced journal + immutable receipt + Core outbox; preserves original")
Rel(discovery,corrections,"Recover registration only; never execute financial corrections")
Rel(corrections,export,"Original / correction GL lineage; financial completion uses Core receipt")
Rel(http,bases,"Capture / inspect / page exact native basis; no supplied balance or clock")
Rel(bases,db,"Core guarded native capture; max 1000 including opening history; no money or enrollment")
Rel(bases,controls,"Current canonical maker / REVIEW after lock; original stable audit")
Rel(discovery,bases,"Wrapping 50-UUID cursor repairs original audit only")
Rel(http,policies,"Propose / approve / publish / inspect / calculate preview")
Rel(policies,registry,"Publish exact approved product-bound version; immutable Core receipt")
Rel(policies,controls,"PERIODIC_POLICY purpose; current Finance maker/checker role and queue")
Rel(registry,db,"Guarded config publication; native digest / product / sequence / current approval checks")
Rel(discovery,policies,"Wrapping 50-request registration cursor; no automatic publication")
Rel(http,export,"Read exact mapping and authenticated receipt")
Rel(http,recovery,"Accept immutable original-export recovery")
Rel(http,controls,"Current Finance role and queue")
Rel(http,reports,"Save / replay / page frozen report observations")
Rel(http,group_match,"Capture / replay / page closed clearing snapshots")
Rel(group_match,clearing,"Signed set manifest then every member; common period/cutoff")
Rel(group_match,reports,"Verify frozen source membership and GL archives")
Rel(group_match,core,"Discover and confirm native facts")
Rel(group_match,payment_read,"Capture original instruction / credit evidence and workflow clock")
Rel(group_match,db,"Separate immutable group / file archives / row references / controls")
Rel(group_match,controls,"Owned cross-file and native differences")
Rel(discovery,group_match,"Fifty pending case links, wrapping past failures")
Rel(http,credit_match,"Capture / replay / page separate immutable credit runs")
Rel(credit_match,reports,"Verify frozen journal and GL membership")
Rel(credit_match,core,"Read native suspense / allocation / original finality / lifetime cap")
Rel(credit_match,payment_read,"Read signed movement receipt and workflow clock")
Rel(credit_match,clearing,"Independent signed credit file and request kind")
Rel(credit_match,db,"Separate V1 immutable sources / controls / items")
Rel(credit_match,controls,"Owned suspense and durable differences")
Rel(discovery,credit_match,"Recover 50 case links, wrapping past failures")
Rel(http,match,"Capture / replay / page immutable matching runs")
Rel(match,reports,"Verify frozen journal / GL source membership")
Rel(match,core,"Read native accounting receipts and guarded finality links")
Rel(match,payment_read,"Read original instruction / provider lineage through owning port")
Rel(match,clearing,"Nonce-bound signed read; raw differences remain classifiable")
Rel(match,db,"Seal private source proofs and exact classified controls")
Rel(match,controls,"Owned per-run observations and durable audit")
Rel(discovery,match,"Recover 50 pending case links; skip failures and wrap")
Rel(http,cash,"Read current independent liquidity status")
Rel(http,revisions,"Propose / inspect / independently approve / publish exact digest")
Rel(revisions,reports,"Verify frozen artifacts and retained source membership")
Rel(revisions,controls,"Stable FINANCE_REPORT registration; canonical people / current roles / queues")
Rel(revisions,db,"Seal intent before Controls; unique predecessor/successor receipt + audit")
Rel(discovery,revisions,"Paged registration recovery after lost acknowledgment or revoked maker")
Rel(reports,core,"Bounded REPEATABLE READ journals / positions / commitments")
Rel(reports,export,"Separate consistent source / chart / receipt comparison")
Rel(reports,cash,"Capture independent observation after database transactions close")
Rel(cash,liquidity,"Signed bounded nonce-bound inquiry")
Rel(reports,db,"Immutable membership / proofs / controls; stable request key")
Rel(reports,controls,"Owned snapshot issues and durable audit")
Rel(discovery,reports,"Recover case-assignment acknowledgments")
Rel(chart,controls,"Separate FINANCE_CHART maker/checker approval")
Rel(discovery,core,"Read bounded immutable source pages")
Rel(discovery,export,"Seal once; repair scheduling acknowledgment")
Rel(export,chart,"Resolve effective version once")
Rel(recovery,job,"Stable recovery job and generation")
Rel(discovery,job,"Original export operation")
Rel(job,export,"Lease and fence committed before HTTP")
Rel(job,provider,"Signed book / inquiry; exact original replay after authenticated NOT_FOUND")
Rel(provider,export,"Scope-checked signed BOOKED receipt")
Rel(export,controls,"Owned mapping / outcome cases; durable audit relay")
Rel(export,db,"Finance principal only")
Rel(core,db,"Core principal; immutable source reads")
Rel(provider,db,"Simulator principal; unique source and export")
Rel(payment_read,db,"Payments principal; consistent read-only transaction")
Rel(clearing,db,"Simulator principal; immutable independent files")
Rel(liquidity,db,"Simulator principal; immutable evidence versions")
SHOW_LEGEND()
@enduml
