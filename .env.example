# Copy to .env (git-ignored, mode 0600) and fill in. Never commit .env.
# scripts/setup_git_remote.sh creates .env from this file and wires git to read it.

# GitHub fine-grained personal access token for pushing to Guaracy-Mendes/piggybank.
# Required permission on that repository: Contents (read and write). Add Workflows (read and write) only if you
# change files under .github/workflows/.
GITHUB_TOKEN=

# Real secrets for anything added later go here too.
#
# Not secrets: the local stack's fixture credentials (dev_admin, local-admin, Synthetic-Local-123!, the
# synthetic-*-only role passwords and signing keys). They are published test values, bound to 127.0.0.1, and the
# binaries refuse any profile other than "local". The scripts already read these optional overrides from the
# environment if you export them:
#   KEYCLOAK_ADMIN_PASSWORD, BANK_FIXTURE_PASSWORD, BANK_IDENTITY_ADMIN_SECRET_FILE,
#   BANK_SESSION_KEYS_FILE, BANK_METRICS_TOKEN_FILE
# See docs/runbooks/local-deployment.md section 8 for the full list.
